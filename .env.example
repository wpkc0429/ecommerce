# ─── docker-compose (infra) ─────────────────────────────────────────────
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── api (Go) ───────────────────────────────────────────────────────────
APP_ENV=development
API_ADDR=:8080
LOG_LEVEL=info

DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce?sslmode=disable
# Atlas dev database: used only by `make migrate-gen` to replay+diff migrations.
DEV_DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce_dev?sslmode=disable
# Integration tests run against this database (wiped between tests).
TEST_DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce_test?sslmode=disable

REDIS_ADDR=localhost:6379

# JWT: admin and member systems use fully isolated secrets (design D9).
ADMIN_JWT_SECRET=dev-only-admin-secret-change-me
MEMBER_JWT_SECRET=dev-only-member-secret-change-me
JWT_ISSUER=ecommerce-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PREVIEW_TOKEN_TTL=10m
# Guest checkout hands back a token scoped to that single order (change
# guest-checkout, design D3). Not a session: no refresh, no order history.
ORDER_ACCESS_TOKEN_TTL=24h
# How long a checkout Idempotency-Key stays replayable (change
# checkout-idempotency, design D8). Long enough to cover a lost response and a
# customer coming back later the same day; short enough that a client which
# wrongly reuses a key cannot turn tomorrow's real purchase into a silent replay.
CHECKOUT_IDEMPOTENCY_TTL=24h

# Initial platform administrator created by `make seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-change-me

# Payment integration (design payment-integration D2/D9): HMAC-SHA256 key
# the mock payment provider signs/verifies webhook payloads with. Demo/
# reference provider only — unlike the JWT secrets above, this is NOT
# required to be set in production.
PAYMENT_MOCK_WEBHOOK_SECRET=dev-only-mock-payment-webhook-secret-change-me

# Which provider a payment request without an explicit "provider" uses
# (change ecpay-payment-provider, design D13). Kept at "mock" so adding the
# ECPay provider changes nothing for existing callers — it decides the
# provider/provider_reference/redirect_form a v1 response carries. A real
# deployment sets this to ecpay.
PAYMENT_DEFAULT_PROVIDER=mock

# ── 綠界 ECPay 全方位金流 (change ecpay-payment-provider) ────────────────
#
# The values below are 綠界's PUBLISHED AIO test store (MerchantID 3002607).
# They are printed in the public documentation and are not secrets.
#
# Careful when replacing them: the widely-circulated 2000132 /
# 5294y06JbISpM5x9 / v77hoKGq4kWxNNIS is an OLD set, and the
# 2000132 / ejCk326UnaZWKisg / q9jcZX8Ib9LM8wYk that search engines surface
# belongs to the B2C 電子發票 API, not to AIO. Either produces a CheckMacValue
# that never matches — a symptom indistinguishable from a bug in the algorithm.
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs

# THE ONLY DIFFERENCE BETWEEN SIMULATED AND LIVE OPERATION (design D1).
# Default: the local cashier stand-in, `make ecpay-sim` (:8090) — no 綠界
# account, no outbound network. The form fields and their checksum are
# byte-identical whichever host this points at:
#   https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5   (綠界 test)
#   https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5         (production)
ECPAY_CHECKOUT_URL=http://localhost:8090/Cashier/AioCheckOut/V5

# Where 綠界 POSTs the payment result. MUST be absolute and reachable from
# 綠界's servers: they only support ports 80/443 and do not accept
# internationalized domain names, so a self-hosted dev box needs a tunnel or a
# reverse proxy. (The local simulator has no such restriction.)
ECPAY_RETURN_URL=http://localhost:8080/api/v1/webhooks/payments/ecpay

# Optional: where 綠界's page sends the browser afterwards. Without it, 綠界's
# page shows no "return to shop" button. The payment RESULT never arrives this
# way — the notification above is the only authority.
ECPAY_CLIENT_BACK_URL=

# 綠界's own advice is to name one method rather than ALL: they keep adding
# payment methods and a new one can break the notification flow. Non-instant
# methods (ATM/CVS/BARCODE) additionally need the PaymentInfoURL 取號通知,
# which this change deliberately does not implement.
ECPAY_CHOOSE_PAYMENT=Credit

# Auth endpoint rate limiting (design auth-rate-limiting D2/D4): sliding
# window per (IP) or (shop + IP [+ email]) key. Broad = coarse per-source
# guard; Tight = per-account brute-force guard. Values below are the
# built-in defaults; uncomment to override.
# RATE_LIMIT_LOGIN_BROAD_LIMIT=20
# RATE_LIMIT_LOGIN_BROAD_WINDOW=5m
# RATE_LIMIT_LOGIN_TIGHT_LIMIT=5
# RATE_LIMIT_LOGIN_TIGHT_WINDOW=5m
# RATE_LIMIT_REGISTER_BROAD_LIMIT=10
# RATE_LIMIT_REGISTER_BROAD_WINDOW=10m
# RATE_LIMIT_REGISTER_TIGHT_LIMIT=3
# RATE_LIMIT_REGISTER_TIGHT_WINDOW=10m
# RATE_LIMIT_REFRESH_LIMIT=30
# RATE_LIMIT_REFRESH_WINDOW=5m
# Guest checkout (change guest-checkout D9): the only unauthenticated endpoint
# that writes business data and holds stock. Broad stays generous (CGNAT puts
# many real buyers on one IP); tight is the per-email bound.
# RATE_LIMIT_GUEST_CHECKOUT_BROAD_LIMIT=20
# RATE_LIMIT_GUEST_CHECKOUT_BROAD_WINDOW=10m
# RATE_LIMIT_GUEST_CHECKOUT_TIGHT_LIMIT=5
# RATE_LIMIT_GUEST_CHECKOUT_TIGHT_WINDOW=10m

# ─── Order notification email (change order-notification-email) ─────────
# 兩封信：訂單成立、付款成功。**不設定 SMTP_USERNAME/SMTP_PASSWORD ＝ 完全不寄信、
# 不報錯、不寫任何列**，系統行為與本 change 之前逐位元組相同（比照 ECPAY_*）。
#
# Gmail 專屬的兩個坑（design D9）：
#   1. SMTP_PASSWORD 必須是開啟兩步驟驗證後產生的「應用程式密碼」——Google 已移除
#      「低安全性應用程式存取」，帳號密碼會直接認證失敗。
#   2. Gmail 會把 From 改寫成通過驗證的那個帳號（除非是已驗證的別名），所以
#      SMTP_FROM 預設就等於 SMTP_USERNAME；設成別的位址不會生效，只會讓人以為生效。
#
# 寄送量上限（design D9，查證後的實際值——網頁介面的 500 不適用於程式寄信）：
#   免費 gmail.com 走 SMTP 約 100 封／日；Google Workspace 2,000 封／日／使用者。
#   額度是滾動 24 小時，超過會鎖住**整個帳號** 1～24 小時（不是退一封信）。
#   一筆走完付款的訂單寄 2 封 ⇒ 免費帳號天花板約 50 筆已付款訂單／日（全平台）。
#   單日訂單數超過 40（免費）或 800（Workspace）就該換掉 Gmail；上線商家數 ≥ 2
#   也該換（額度與寄件信譽是全平台共用的一個帳號）。
#   實際封數：SELECT count(*) FROM order_notifications
#             WHERE created_at >= now() - interval '24 hours';
#
# 換成其他交易信服務商（SES/Postmark/Resend…）最省只需改下面三個值——
# internal/notify 沒有任何一個字是 Gmail 專屬的。
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=          # 留空＝等於 SMTP_USERNAME
# SMTP_FROM_NAME=
# SMTP_TIMEOUT=20s    # 一次投遞的硬上限（撥號＋TLS＋認證＋DATA）
# 分派器（design D5）：行程內、有界、關閉時排空——**不是**持久化工作佇列。
# NOTIFY_WORKERS=4
# NOTIFY_QUEUE_SIZE=256

# ─── web (storefront SSR) ───────────────────────────────────────────────
API_BASE_URL=http://localhost:8080
WEB_PORT=3000

# ─── admin (thin SPA) ───────────────────────────────────────────────────
ADMIN_PORT=3001
