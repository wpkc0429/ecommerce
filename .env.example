# ─── docker-compose (infra) ─────────────────────────────────────────────
# Secrets below are PLACEHOLDERS. Generate your own once, e.g.
#   openssl rand -hex 32
# or, in PowerShell (any CSPRNG works):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { '{0:x2}' -f $_ })
# docker-compose REFUSES TO START without POSTGRES_PASSWORD / REDIS_PASSWORD
# (no weak fallback). Ports are bound to 127.0.0.1 only.
# Use hex (or other URL-safe) passwords: POSTGRES_PASSWORD is repeated inside
# the *_DATABASE_URL values below and must match them exactly.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=<generate: openssl rand -hex 32>
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432
REDIS_PORT=6379

# MinIO: the local stand-in for Cloudflare R2 (change product-images-r2). Same
# rule as Postgres/Redis: no default credentials, compose REFUSES TO START
# without them. Ports are bound to 127.0.0.1 only. Generate your own local-only
# values (openssl rand -hex 16 / -hex 24); MINIO_ROOT_PASSWORD needs >= 8 chars.
MINIO_ROOT_USER=<generate: openssl rand -hex 16>
MINIO_ROOT_PASSWORD=<generate: openssl rand -hex 24>
# Buckets created at first start (anonymous read = the public image domain).
# The second is for e2e runs so their objects can be wiped on their own.
MINIO_BUCKET=ecommerce-media
MINIO_BUCKET_E2E=ecommerce-media-e2e
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# Origins allowed to PUT presigned uploads straight from the browser (admin SPA).
# MINIO_CORS_ALLOW_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# ─── api (Go) ───────────────────────────────────────────────────────────
# development | test | production. UNSET MEANS production (fail closed).
# Outside development/test the API (and migrate/seed) REFUSE TO START when any
# secret below is empty, a known default (dev-only-*, *change-me*, the public
# PAYMENT_CREDENTIALS_ENCRYPTION_KEY, "ecommerce" as DB password, ...) or an
# unfilled <placeholder>; JWT secrets must also be >= 32 bytes and differ.
# `seed -demo` is refused outside development/test.
APP_ENV=development
API_ADDR=:8080
LOG_LEVEL=info

# Client IP behind a reverse proxy / Cloudflare Tunnel. Comma-separated IPs or
# CIDRs of peers whose CF-Connecting-IP header is believed (rate limiting and
# request logs). Empty = trust nobody, client IP is always the TCP peer.
# X-Forwarded-For is never used. For cloudflared running on this host:
#   TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Note: any local process can then claim any IP via that header; only list
# peers that are actually the tunnel/proxy.
TRUSTED_PROXIES=

DATABASE_URL=postgres://ecommerce:<POSTGRES_PASSWORD>@localhost:5432/ecommerce?sslmode=disable
# Atlas dev database: used only by `make migrate-gen` to replay+diff migrations.
DEV_DATABASE_URL=postgres://ecommerce:<POSTGRES_PASSWORD>@localhost:5432/ecommerce_dev?sslmode=disable
# Integration tests run against this database (wiped between tests).
TEST_DATABASE_URL=postgres://ecommerce:<POSTGRES_PASSWORD>@localhost:5432/ecommerce_test?sslmode=disable

REDIS_ADDR=localhost:6379
# Redis requirepass (caches + the Lua sliding-window rate limiter). Read by
# docker-compose (server side) and by the API/integration tests (AUTH).
# Empty = no AUTH, only for a Redis that has no password (e.g. CI).
REDIS_PASSWORD=<generate: openssl rand -hex 32>
# Logical Redis database (default 0). Give a second local stack (e.g. an e2e
# run on a separate Postgres database) a different one so caches and
# rate-limit buckets do not mix.
# REDIS_DB=0

# JWT: admin and member systems use fully isolated secrets (design D9).
# Generate two DIFFERENT values, e.g. openssl rand -base64 48 (each).
ADMIN_JWT_SECRET=<generate: openssl rand -base64 48>
MEMBER_JWT_SECRET=<generate: openssl rand -base64 48, different from admin>
JWT_ISSUER=ecommerce-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PREVIEW_TOKEN_TTL=10m
# Guest checkout hands back a token scoped to that single order (change
# guest-checkout, design D3). Not a session: no refresh, no order history.
ORDER_ACCESS_TOKEN_TTL=24h
# How long a checkout Idempotency-Key stays replayable (change
# checkout-idempotency, design D8). Long enough to cover a lost response and a
# customer coming back later the same day; short enough that a client which
# wrongly reuses a key cannot turn tomorrow's real purchase into a silent replay.
CHECKOUT_IDEMPOTENCY_TTL=24h

# Initial platform administrator created by `make seed`. Only applies when the
# user does not exist yet — changing it later does NOT change an existing
# admin's password. The browser E2E reads it from .env as well.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<generate: openssl rand -base64 18>

# Payment integration (design payment-integration D2/D9): HMAC-SHA256 key
# the mock payment provider signs/verifies webhook payloads with. Demo/
# reference provider only, but its webhook route is always mounted, so
# outside development/test a real random value is REQUIRED (a public key would
# let anyone forge "payment succeeded" callbacks).
PAYMENT_MOCK_WEBHOOK_SECRET=dev-only-mock-payment-webhook-secret-change-me

# Which provider a payment request without an explicit "provider" uses
# (change ecpay-payment-provider, design D13). Kept at "mock" so adding the
# ECPay provider changes nothing for existing callers — it decides the
# provider/provider_reference/redirect_form a v1 response carries. A real
# deployment sets this to ecpay.
PAYMENT_DEFAULT_PROVIDER=mock

# Time zone merchant reports fall back to when a shop has not set its own
# (change merchant-reports, design D1). Must be an IANA name — the service
# REFUSES TO START if it is not, because a typo here would turn every report
# of every unconfigured shop into a 500.
#
# A shop that has set its own zone is unaffected by this value; a shop that has
# not is told, in the response and on screen, that its dates were cut by this
# platform default rather than by a choice it made. Leaving it unset behaves
# exactly as the value shown.
REPORT_DEFAULT_TIMEZONE=Asia/Taipei

# ── 綠界 ECPay 全方位金流 (change ecpay-payment-provider) ────────────────
#
# change ecpay-per-shop-credentials: MerchantID/HashKey/HashIV/ChoosePayment
# are no longer read from the environment — each shop sets its own via
# PUT /api/v1/admin/shops/{shopID}/ecpay-credentials (encrypted at rest,
# key below). `make seed-demo` seeds the demo shop's row with the same 綠界
# PUBLISHED AIO test-store values (MerchantID 3002607) these env vars used to
# carry, so local dev/E2E behavior is unchanged.
#
# ECPAY_HASH_KEY/ECPAY_HASH_IV below are consumed ONLY by the local cashier
# stand-in (`api/cmd/ecpay-sim`, a separate binary) to verify the
# CheckMacValue it receives — NOT by the main API server. Keep them equal to
# whatever a shop's stored credentials are (the demo shop's default is 綠界's
# published sample), or the simulator will reject a genuine request.
#
# Careful when replacing them: the widely-circulated 2000132 /
# 5294y06JbISpM5x9 / v77hoKGq4kWxNNIS is an OLD set, and the
# 2000132 / ejCk326UnaZWKisg / q9jcZX8Ib9LM8wYk that search engines surface
# belongs to the B2C 電子發票 API, not to AIO. Either produces a CheckMacValue
# that never matches — a symptom indistinguishable from a bug in the algorithm.
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs

# THE ONLY DIFFERENCE BETWEEN SIMULATED AND LIVE OPERATION (design D1) —
# platform-wide: which 綠界 environment the whole deployment talks to, not a
# merchant identity. Default: the local cashier stand-in, `make ecpay-sim`
# (:8090) — no 綠界 account, no outbound network. The form fields and their
# checksum are byte-identical whichever host this points at:
#   https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5   (綠界 test)
#   https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5         (production)
ECPAY_CHECKOUT_URL=http://localhost:8090/Cashier/AioCheckOut/V5

# The BASE of where 綠界 POSTs the payment result — the per-shop webhook path
# (`/{shopID}`) is appended at InitiatePayment time (change
# ecpay-per-shop-credentials, design D2), since 綠界 only ever echoes back
# whatever ReturnURL we hand it. MUST be absolute and reachable from 綠界's
# servers: they only support ports 80/443 and do not accept internationalized
# domain names, so a self-hosted dev box needs a tunnel or a reverse proxy.
# (The local simulator has no such restriction.)
ECPAY_RETURN_URL=http://localhost:8080/api/v1/webhooks/payments/ecpay

# Optional: where 綠界's page sends the browser afterwards. Without it, 綠界's
# page shows no "return to shop" button. The payment RESULT never arrives this
# way — the notification above is the only authority.
ECPAY_CLIENT_BACK_URL=

# ── 每商家金流憑證加密金鑰 (change ecpay-per-shop-credentials, design D4) ──
#
# Encrypts every shop's stored MerchantID/HashKey/HashIV/ChoosePayment
# (AES-256-GCM). Hex or base64, MUST decode to exactly 32 bytes — the service
# REFUSES TO START otherwise, the same treatment REPORT_DEFAULT_TIMEZONE gets.
#
# Leaving it unset falls back to a FIXED, PUBLIC dev key built into config.go
# (it ships in this repo) — generate a private one instead:
#   openssl rand -hex 32
# There is no recovery path for a lost key: rotating it means every shop
# re-enters its credentials (rows encrypted with the old key no longer decrypt),
# the same way a lost password means a reset, not a recovery.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=<generate: openssl rand -hex 32>

# Auth endpoint rate limiting (design auth-rate-limiting D2/D4): sliding
# window per (IP) or (shop + IP [+ email]) key. Broad = coarse per-source
# guard; Tight = per-account brute-force guard. Values below are the
# built-in defaults; uncomment to override.
# RATE_LIMIT_LOGIN_BROAD_LIMIT=20
# RATE_LIMIT_LOGIN_BROAD_WINDOW=5m
# RATE_LIMIT_LOGIN_TIGHT_LIMIT=5
# RATE_LIMIT_LOGIN_TIGHT_WINDOW=5m
# RATE_LIMIT_REGISTER_BROAD_LIMIT=10
# RATE_LIMIT_REGISTER_BROAD_WINDOW=10m
# RATE_LIMIT_REGISTER_TIGHT_LIMIT=3
# RATE_LIMIT_REGISTER_TIGHT_WINDOW=10m
# RATE_LIMIT_REFRESH_LIMIT=30
# RATE_LIMIT_REFRESH_WINDOW=5m
# Guest checkout (change guest-checkout D9): the only unauthenticated endpoint
# that writes business data and holds stock. Broad stays generous (CGNAT puts
# many real buyers on one IP); tight is the per-email bound.
# RATE_LIMIT_GUEST_CHECKOUT_BROAD_LIMIT=20
# RATE_LIMIT_GUEST_CHECKOUT_BROAD_WINDOW=10m
# RATE_LIMIT_GUEST_CHECKOUT_TIGHT_LIMIT=5
# RATE_LIMIT_GUEST_CHECKOUT_TIGHT_WINDOW=10m

# ─── Order notification email (change order-notification-email) ─────────
# 兩封信：訂單成立、付款成功。**不設定 SMTP_USERNAME/SMTP_PASSWORD ＝ 完全不寄信、
# 不報錯、不寫任何列**，系統行為與本 change 之前逐位元組相同（比照 ECPAY_*）。
#
# Gmail 專屬的兩個坑（design D9）：
#   1. SMTP_PASSWORD 必須是開啟兩步驟驗證後產生的「應用程式密碼」——Google 已移除
#      「低安全性應用程式存取」，帳號密碼會直接認證失敗。
#   2. Gmail 會把 From 改寫成通過驗證的那個帳號（除非是已驗證的別名），所以
#      SMTP_FROM 預設就等於 SMTP_USERNAME；設成別的位址不會生效，只會讓人以為生效。
#
# 寄送量上限（design D9，查證後的實際值——網頁介面的 500 不適用於程式寄信）：
#   免費 gmail.com 走 SMTP 約 100 封／日；Google Workspace 2,000 封／日／使用者。
#   額度是滾動 24 小時，超過會鎖住**整個帳號** 1～24 小時（不是退一封信）。
#   一筆走完付款的訂單寄 2 封 ⇒ 免費帳號天花板約 50 筆已付款訂單／日（全平台）。
#   單日訂單數超過 40（免費）或 800（Workspace）就該換掉 Gmail；上線商家數 ≥ 2
#   也該換（額度與寄件信譽是全平台共用的一個帳號）。
#   實際封數：SELECT count(*) FROM order_notifications
#             WHERE created_at >= now() - interval '24 hours';
#
# 換成其他交易信服務商（SES/Postmark/Resend…）最省只需改下面三個值——
# internal/notify 沒有任何一個字是 Gmail 專屬的。
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=          # 留空＝等於 SMTP_USERNAME
# SMTP_FROM_NAME=
# SMTP_TIMEOUT=20s    # 一次投遞的硬上限（撥號＋TLS＋認證＋DATA）
# 分派器（design D5）：行程內、有界、關閉時排空——**不是**持久化工作佇列。
# NOTIFY_WORKERS=4
# NOTIFY_QUEUE_SIZE=256

# ─── Product images: object storage (change product-images-r2) ──────────
# Cloudflare R2 in production, MinIO locally — the SAME S3 code path. The five
# values below are ALL-OR-NOTHING: all set = image upload enabled, all empty =
# disabled (media routes still exist and answer 503 media_not_configured, the
# public `images` is []), only some set = the API REFUSES TO START and names
# the missing keys. See docs/media-r2-setup.md for what to create in Cloudflare.
#
# Local development (MinIO from docker compose); use the SAME values you put in
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above:
#   R2_ACCOUNT_ID=local
#   R2_ACCESS_KEY_ID=<same as MINIO_ROOT_USER>
#   R2_SECRET_ACCESS_KEY=<same as MINIO_ROOT_PASSWORD>
#   R2_BUCKET=ecommerce-media
#   R2_ENDPOINT=http://127.0.0.1:9000
#   IMAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/ecommerce-media
# Production (values come from the Cloudflare dashboard; NEVER commit them):
#   R2_ACCOUNT_ID=<Cloudflare account id>
#   R2_ACCESS_KEY_ID=<R2 API token access key id>
#   R2_SECRET_ACCESS_KEY=<R2 API token secret>
#   R2_BUCKET=<bucket name>
#   IMAGE_PUBLIC_BASE_URL=https://img.example.com   # custom domain, https, no trailing slash
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# IMAGE_PUBLIC_BASE_URL=
# Optional: override the endpoint (MinIO only; default is
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com).
# R2_ENDPOINT=
# Extra image-URL prefixes CMS image fields may use besides IMAGE_PUBLIC_BASE_URL
# (comma-separated, migration period only).
# IMAGE_EXTRA_ALLOWED_ORIGINS=
# Tuning (defaults shown). Set MEDIA_PROCESS_CONCURRENCY=1 on a VPS with < 1GB RAM.
# MEDIA_MAX_BYTES=15728640
# MEDIA_MAX_PIXELS=40000000
# MEDIA_PROCESS_CONCURRENCY=2
# MEDIA_WEBP_QUALITY=80
# MEDIA_UPLOAD_URL_TTL=10m

# ─── back-office account provisioning (change platform-account-provisioning) ─
# Base of the one-time password setup / reset links handed to new admin users:
#   {ADMIN_PUBLIC_URL}/#/set-password/{token}
# MUST be the origin of the SHARED MERCHANT admin SPA, NOT the platform
# administrator's own admin domain (that one sits behind an access policy that
# only admits the platform owner, so a merchant owner opening the link is
# turned away). http(s) origin only: no path, no trailing slash, no fragment.
# Until the VPS move there is no outbound mail for admin accounts, so the link
# is always returned in the API response (delivery: "manual").
ADMIN_PUBLIC_URL=http://localhost:3001
# ADMIN_SETUP_TOKEN_TTL=72h   # link for a newly created account
# ADMIN_RESET_TOKEN_TTL=24h   # link for a password reset
# ADMIN_INVITE_TOKEN_TTL=168h # shop invitation link (7 days); {ADMIN_PUBLIC_URL}/#/accept-invite/{token}

# ─── web (storefront SSR) ───────────────────────────────────────────────
API_BASE_URL=http://localhost:8080
WEB_PORT=3000

# ─── admin (thin SPA) ───────────────────────────────────────────────────
ADMIN_PORT=3001
